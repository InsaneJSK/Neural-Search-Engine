# Optional for live search. Leave blank to use Tavily keyless access.
TAVILY_API_KEY=

# Optional answer generation: Groq first, local Ollama as fallback.
# Keep the real key in .env; never include it in browser code or a workflow export.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen3:4b
