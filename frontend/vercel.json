{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {"api/demo.mjs": {"maxDuration": 300}},
  "rewrites": [
    {"source":"/health", "destination":"/api/demo?route=/health"},
    {"source":"/search", "destination":"/api/demo?route=/search"},
    {"source":"/answer", "destination":"/api/demo?route=/answer"},
    {"source":"/mcp", "destination":"/api/demo?route=/mcp"}
  ]
}
